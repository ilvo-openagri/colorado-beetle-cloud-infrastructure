[Unit]
Description=OpenAgri Dash UI
After=network.target

[Service]
WorkingDirectory=/opt/openagri/streamlit
Environment=PYTHONPATH=/opt/openagri/streamlit/workspaces
ExecStart=/opt/openagri/streamlit/.venv/bin/python -m dash_app --env-file=/opt/openagri/streamlit/workspaces/.env
Restart=on-failure
RestartSec=5s
TimeoutSec=30
StandardOutput=append:/var/log/openagri/dash.log
StandardError=append:/var/log/openagri/dash.log
User=openagri


[Install]
WantedBy=multi-user.target
